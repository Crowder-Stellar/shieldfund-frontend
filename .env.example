# ─────────────────────────────────────────────────────────────────────────────
# ShieldFund Frontend — environment variables
#
# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Network: TESTNET (default) | MAINNET. Invalid values fail the build.
VITE_STELLAR_NETWORK=TESTNET

# Soroban RPC URL override. Required for MAINNET (no keyless public default);
# anything set here ships in the public bundle, so use an origin-restricted key.
# VITE_SOROBAN_RPC_URL=https://...

# Contract IDs — deployed to Stellar testnet 2026-06-28
# Replace with your own after running shieldfund-contracts/scripts/deploy-testnet.sh
VITE_TREASURY_VAULT_CONTRACT_ID=CAUWJPC73YLQMSV6X4QPLUVS2UZFE2PMRIQSSCDN62DNN6J76Y5RETIG
VITE_STREAMING_CONTRACT_ID=CDU7ZIVQ3UC4K3DHV3NMQGW5UMSYFCKCC6YJKHT4YLNEZJRWL6THE6WQ
VITE_PROOF_REGISTRY_CONTRACT_ID=CBDLHQQPKC5524CFWPD4HMPTZGWBYQNW3IKGAFH6IAYBU3F2F6AO2332

# ShieldFund backend API URL. Proof requests (including budget caps and salts)
# go only here; the backend calls shieldfund-proof-server and anchors the proof.
# Its origin is also added to the Content-Security-Policy connect-src at build.
VITE_API_BASE_URL=http://localhost:4000
